#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        singleQu {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <19 20>;
            timeout-ms = <800>;
            layers = <0>;
        };

        backquat {
            bindings = <&kp GRAVE>;
            key-positions = <19 20>;
            timeout-ms = <800>;
            layers = <2>;
        };

        tidle {
            bindings = <&kp TILDE>;
            key-positions = <31 32>;
            timeout-ms = <800>;
            layers = <2>;
        };

        windowmax {
            bindings = <&kp LC(LG(UP_ARROW))>;
            key-positions = <31 32>;
            timeout-ms = <800>;
            layers = <3>;
        };

        backdel {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
            timeout-ms = <800>;
            layers = <0 1 3>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <8 9>;
            timeout-ms = <800>;
            layers = <2>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
            timeout-ms = <800>;
            layers = <0 3 2>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            timeout-ms = <800>;
            layers = <1>;
        };

        a+l+left {
            bindings = <&kp LA(LG(LEFT_ARROW))>;
            key-positions = <19 20>;
            timeout-ms = <500>;
            require-prior-idle-ms = <500>;
            layers = <1>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q           &kp W      &kp E      &kp R     &kp T                                  &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A           &kp S      &kp D      &kp F     &kp G                       &none      &kp H        &kp J  &kp K      &kp L    &kp SEMICOLON
&kp Z           &kp X      &kp C      &kp V     &kp B        &kp RCTRL      &none      &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_SHIFT  &mkp RCLK  &mkp LCLK  &kp LCMD  &lt 1 LANG2  &lt 3 SPACE    &kp ENTER  &lt 2 LANG1                             &kp LEFT_ALT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4   &kp NUMBER_5                    &kp NUMBER_6    &kp NUMBER_7     &kp NUMBER_8  &kp NUMBER_9              &kp NUMBER_0
&kp F1        &kp F2        &kp F3        &kp LA(LG(C))  &trans                  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW   &kp UP_ARROW  &kp RIGHT_ARROW           &kp LA(LG(PERIOD))
&kp F4        &kp F5        &kp F6        &trans         &trans        &trans    &trans  &trans          &kp LS(LA(TAB))  &kp LA(TAB)   &kp LS(LG(LEFT_BRACKET))  &kp LS(LG(RIGHT_BRACKET))
&trans        &trans        &trans        &trans         &trans        &trans    &trans  &kp RA(SPACE)                                                            &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_2 {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp POUND  &kp DOLLAR  &kp PERCENT                    &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LPAR           &kp RPAR
&kp F7           &kp F8       &kp F9     &trans      &trans                 &trans  &kp MINUS       &kp EQUAL      &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp PIPE
&kp F10          &kp F11      &kp F12    &trans      &trans       &trans    &trans  &kp UNDERSCORE  &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH
&trans           &trans       &trans     &trans      &trans       &trans    &trans  &trans                                                              &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans             &trans                                               &kp LC(LA(LG(LEFT_ARROW)))  &kp LC(LA(LG(DOWN_ARROW)))   &kp LA(LC(LG(RIGHT_ARROW)))     &trans                           &trans
&trans  &trans  &trans  &trans             &trans                            &trans             &kp LS(LA(LG(LEFT_ARROW)))  &kp LS(LA(LG(RIGHT_ARROW)))  &kp LS(LA(LC(LG(LEFT_ARROW))))  &kp LA(LS(LC(LG(RIGHT_ARROW))))  &trans
&trans  &trans  &trans  &kp LC(LA(LG(Z)))  &kp LA(LC(LG(PERIOD)))  &trans    &trans             &kp LC(LG(LEFT_ARROW))      &kp LC(LG(LS(DOWN_ARROW)))   &kp LC(LG(LS(UP_ARROW)))        &kp LC(LG(RIGHT_ARROW))          &kp LA(LC(LG(UP_ARROW)))
&trans  &trans  &trans  &trans             &trans                  &trans    &kp LC(LA(LG(X)))  &kp LC(UP_ARROW)                                                                                                          &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &mkp MB3  &mkp MB2  &mkp MB1  &trans            &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans
&trans  &trans    &trans    &trans    &trans  &trans    &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans    &trans    &trans    &trans  &trans    &trans  &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
